{
  "filenameTemplate": "Snipline_{datetime:yyyy-MM-dd_HH-mm-ss-zzz}_{uuid}",
  "clipboard": true,
  "notifications": true,
  "notificationTimeout": 5000,
  "screenshots": {
    "directory": "~/Pictures/Snipline",
    "editor": "",
    "target": "region",
    "live": true,
    "format": "png"
  },
  "recording": {
    "directory": "~/Videos/Snipline",
    "editor": "",
    "format": "mp4",
    "codec": "auto",
    "encoder": "auto",
    "fps": 30,
    "countdown": 3,
    "maxDuration": 3600
  },
  "ocr": {
    "languages": [
      "eng"
    ]
  },
  "uploaders": {
    "default": "catbox",
    "timeout": 180,
    "custom": []
  },
  "lens": {
    "destination": "litterbox-1h"
  },
  "keybindings": {
    "confirm": [
      "Return",
      "Enter",
      "Space"
    ],
    "cancel": [
      "Escape"
    ],
    "live": [
      "Ctrl+L"
    ],
    "cursor": [
      "Ctrl+Shift+C"
    ],
    "save": [
      "Ctrl+S"
    ],
    "copy": [
      "Ctrl+C"
    ],
    "open": [
      "Ctrl+O"
    ],
    "folder": [
      "Ctrl+Shift+O"
    ],
    "edit": [
      "Ctrl+E"
    ],
    "upload": [
      "Ctrl+U"
    ],
    "capture": [
      "Ctrl+1"
    ],
    "record": [
      "Ctrl+2"
    ],
    "qr": [
      "Ctrl+3"
    ],
    "ocr": [
      "Ctrl+4"
    ],
    "lens": [
      "Ctrl+5"
    ],
    "region": [
      "Shift+1"
    ],
    "monitor": [
      "Shift+2"
    ],
    "window": [
      "Shift+3"
    ]
  }
}
